Dependency Inversion) 원칙: 클라이언트는\n자신이사용하는메소드와의존관계를갖지않도록해야한다.", "choices": [{"r": 0, "x0": 0.0, "y0": 588.5, "x1": 295.5, "y1": 647.2, "m": [42.5, 591.5, 51.3, 601.3]}, {"r": 0, "x0": 0.0, "y0": 647.2, "x1": 295.5, "y1": 706.0, "m": [42.5, 650.2, 51.3, 660.0]}, {"r": 0, "x0": 0.0, "y0": 706.0, "x1": 295.5, "y1": 745.2, "m": [42.5, 709.0, 51.3, 718.8]}, {"r": 0, "x0": 0.0, "y0": 745.2, "x1": 295.5, "y1": 782.5, "m": [42.5, 748.2, 51.3, 758.0]}], "answer": [2]}]}