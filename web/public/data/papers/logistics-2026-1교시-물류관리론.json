 76.0, 199.7]}, {"r": 0, "x0": 298.2, "y0": 182.3, "x1": 595.0, "y1": 204.6, "m": [302.2, 185.3, 314.2, 199.7]}, {"r": 0, "x0": 0.0, "y0": 204.6, "x1": 595.0, "y1": 227.1, "m": [64.0, 207.6, 76.0, 222.0]}], "orig": 37, "answer": [2]}, {"no": 38, "regions": [{"page": 10, "x0": 0.0, "y0": 248.6, "x1": 595.0, "y1": 384.1}], "text": "38. 물류공동화도입을위한전제조건으로옳지않은것은?\n①참여하는화주기업들의물류업무에유사성이있어야한다.\n②참여하는화주기업들의이해가일치해야한다.\n③물류공동화추진및운영을위한간사역할의회사가있어야한다.\n④물류공동화운영규칙과비용산정기준을수립하고체계화해야한다.\n⑤제품특성을반영하여화주별로최적의파렛트규격을정해야한다.", "choices": [{"r": 0, "x0": 0.0, "y0": 272.7, "x1": 595.0, "y1": 295.0, "m": [64.0, 275.7, 76.0, 290.1]}, {"r": 0, "x0": 0.0, "y0": 295.0, "x1": 595.0, "y1": 317.3, "m": [64.0, 298.0, 76.0, 312.4]}, {"r": 0, "x0": 0.0, "y0": 317.3, "x1": 595.0, "y1": 339.5, "m": [64.0, 320.3, 76.0, 334.7]}, {"r": 0, "x0": 0.0, "y0": 339.5, "x1": 595.0, "y1": 361.8, "m": [64.0, 342.5, 76.0, 356.9]}, {"r": 0, "x0": 0.0, "y0": 361.8, "x1": 595.0, "y1": 384.1, "m": [64.0, 364.8, 76.0, 379.1]}], "orig": 38, "answer": [5]}, {"no": 39, "regions": [{"page": 10, "x0": 0.0, "y0": 405.9, "x1": 595.0, "y1": 612.5}], "text": "39. A기업은수송부문의연비개선을통해이산화탄소배출량을25% 감소시키고자\n한다. 연비법에의한이산화탄소배출량산출식및관련자료가다음과같을\n때목표연비(km/L)는?\n○이산화탄소배출량(kg) = 주행거리(km) ÷ 연비(km/L) × 이산화탄소\n배출계수(kg/L)\n○현재연비: 6 km/L\n○총주행거리: 120,000 km\n○이산화탄소배출계수: 0.002 kg/L\n①4\n②5\n③7\n④8\n⑤16", "choices": [{"r": 0, "x0": 0.0, "y0": 590.1, "x1": 155.3, "y1": 612.5, "m": [64.0, 593.1, 76.0, 607.5]}, {"r": 0, "x0": 155.3, "y0": 590.1, "x1": 250.6, "y1": 612.5, "m": [159.3, 593.1, 171.3, 607.5]}, {"r": 0, "x0": 250.6, "y0": 590.1, "x1": 345.9, "y1": 612.5, "m": [254.6, 593.1, 266.6, 607.5]}, {"r": 0, "x0": 345.9, "y0": 590.1, "x1": 441.1, "y1": 612.5, "m": [349.9, 593.1, 361.8, 607.5]}, {"r": 0, "x0": 441.1, "y0": 590.1, "x1": 595.0, "y1": 612.5, "m": [445.1, 593.1, 457.1, 607.5]}], "orig": 39, "answer": [4]}, {"no": 40, "regions": [{"page": 10, "x0": 0.0, "y0": 634.2, "x1": 595.0, "y1": 789.3}], "text": "40. 스마트물류기술에관한설명으로옳지않은것은?\n①블록체인은분산원장을통해공급사슬의거래투명성을향상시킨다.\n②빅데이터기술은대용량데이터를수집, 분석, 시각화하는기술이다.\n③IoT는사물간의통신을통해실시간데이터수집을가능하게한다.\n④인공지능(AI)은자연어처리, 시각적인지등의기술을이용하여의사결정을\n지원할수있다.\n⑤VAN 서비스는IaaS, PaaS, SaaS 등으로구분하며사이버보안을강화한기술이다.", "choices": [{"r": 0, "x0": 0.0, "y0": 658.2, "x1": 595.0, "y1": 680.5, "m": [64.0, 661.2, 76.0, 675.6]}, {"r": 0, "x0": 0.0, "y0": 680.5, "x1": 595.0, "y1": 702.8, "m": [64.0, 683.5, 76.0, 697.9]}, {"r": 0, "x0": 0.0, "y0": 702.8, "x1": 595.0, "y1": 725.1, "m": [64.0, 705.8, 76.0, 720.2]}, {"r": 0, "x0": 0.0, "y0": 725.1, "x1": 595.0, "y1": 766.6, "m": [64.0, 728.1, 76.0, 742.5]}, {"r": 0, "x0": 0.0, "y0": 766.6, "x1": 595.0, "y1": 789.3, "m": [64.0, 769.6, 76.0, 783.9]}], "orig": 40, "answer": [5]}]}