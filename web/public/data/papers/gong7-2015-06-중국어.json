n④半边天", "choices": [{"r": 0, "x0": 298.5, "y0": 788.8, "x1": 453.0, "y1": 805.6, "m": [331.7, 791.8, 340.6, 801.6]}, {"r": 0, "x0": 453.0, "y0": 788.8, "x1": 595.0, "y1": 805.6, "m": [457.0, 791.8, 465.8, 801.6]}, {"r": 0, "x0": 298.5, "y0": 805.6, "x1": 453.0, "y1": 823.4, "m": [331.7, 808.6, 340.6, 818.4]}, {"r": 0, "x0": 453.0, "y0": 805.6, "x1": 595.0, "y1": 823.4, "m": [457.0, 808.6, 465.8, 818.4]}], "answer": [4]}]}