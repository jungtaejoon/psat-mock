, 402.2, 102.9]}, {"r": 0, "x0": 365.0, "y0": 105.4, "x1": 728.0, "y1": 142.8, "m": [391.8, 108.4, 402.2, 121.6]}, {"r": 0, "x0": 365.0, "y0": 142.8, "x1": 728.0, "y1": 182.4, "m": [391.8, 145.8, 402.2, 159.1]}], "answer": [1]}, {"no": 10, "regions": [{"page": 1, "x0": 365.0, "y0": 462.5, "x1": 728.0, "y1": 649.1}], "text": "10. 이상적인 저역통과 필터의 주파수 진폭 응답 이 다음과 같을 때,\n입력 cos에 대한 필터의 출력 는?\n≤kHz\n\nkHz\n①\n②cos\ncos\n③\ncos\n④", "choices": [{"r": 0, "x0": 365.0, "y0": 542.1, "x1": 728.0, "y1": 561.1, "m": [391.8, 545.1, 402.2, 558.4]}, {"r": 0, "x0": 365.0, "y0": 561.1, "x1": 728.0, "y1": 587.2, "m": [391.8, 564.1, 402.2, 577.3]}, {"r": 0, "x0": 365.0, "y0": 587.2, "x1": 728.0, "y1": 620.8, "m": [391.8, 590.2, 402.2, 603.4]}, {"r": 0, "x0": 365.0, "y0": 620.8, "x1": 728.0, "y1": 649.1, "m": [391.8, 623.8, 402.2, 637.0]}], "answer": [1]}, {"no": 11, "regions": [{"page": 2, "x0": 0.0, "y0": 50.8, "x1": 362.0, "y1": 170.0}], "text": "11. 신호 cossin에 대한 복소 지수 푸리에\n계수는? (단, 는 기본 주파수이고 > 0이다)\n①, , \n②, , \n③, , \n④, , ", "choices": [{"r": 0, "x0": 0.0, "y0": 92.0, "x1": 362.0, "y1": 110.9, "m": [37.8, 95.0, 48.3, 108.2]}, {"r": 0, "x0": 0.0, "y0": 110.9, "x1": 362.0, "y1": 129.9, "m": [37.8, 113.9, 48.3, 127.2]}, {"r": 0, "x0": 0.0, "y0": 129.9, "x1": 362.0, "y1": 148.8, "m": [37.8, 132.9, 48.3, 146.1]}, {"r": 0, "x0": 0.0, "y0": 148.8, "x1": 362.0, "y1": 170.0, "m": [37.8, 151.8, 48.3, 165.0]}], "answer": [4]}, {"no": 12, "regions": [{"page": 2, "x0": 0.0, "y0": 375.0, "x1": 362.0, "y1": 506.8}], "text": "12. AWGN 채널에서 통신시스템 A, B의 신호대잡음비(SNR)가 각각\n20 [dB], 40 [dB]이고, 섀넌(Shannon)의 채널용량이 각각 50 [Mbps]\n일 때, A, B의 채널 대역폭에 대한 설명으로 옳은 것은?\n①A의 대역폭> B의 대역폭\n②A의 대역폭< B의 대역폭\n③A의 대역폭＝B의 대역폭\n④대역폭은 신호대잡음비와 상관이 없다.", "choices": [{"r": 0, "x0": 0.0, "y0": 429.4, "x1": 362.0, "y1": 448.1, "m": [37.8, 432.4, 48.3, 445.6]}, {"r": 0, "x0": 0.0, "y0": 448.1, "x1": 362.0, "y1": 466.8, "m": [37.8, 451.1, 48.3, 464.3]}, {"r": 0, "x0": 0.0, "y0": 466.8, "x1": 362.0, "y1": 485.5, "m": [37.8, 469.8, 48.3, 483.1]}, {"r": 0, "x0": 0.0, "y0": 485.5, "x1": 362.0, "y1": 506.8, "m": [37.8, 488.5, 48.3, 501.8]}], "answer": [1]}, {"no": 13, "regions": [{"page": 2, "x0": 0.0, "y0": 712.0, "x1": 362.0, "y1": 809.1}], "text": "13. 진 PSK에 대한 설명으로 옳지 않은 것은?\n①심볼당 비트 수는 log이다.\n②각 심볼은 개의 서로 다른 위상값을 갖는다.\n③비트 매핑에 그레이(Gray) 부호를 적용할 수 없다.\n④각 심볼은 성상도에서 동일 반경의 원주상에 위치한다.", "choices": [{"r": 0, "x0": 0.0, "y0": 729.2, "x1": 362.0, "y1": 750.4, "m": [37.8, 732.2, 48.3, 745.4]}, {"r": 0, "x0": 0.0, "y0": 750.4, "x1": 362.0, "y1": 769.1, "m": [37.8, 753.4, 48.3, 766.6]}, {"r": 0, "x0": 0.0, "y0": 769.1, "x1": 362.0, "y1": 787.8, "m": [37.8, 772.1, 48.3, 785.4]}, {"r": 0, "x0": 0.0, "y0": 787.8, "x1": 362.0, "y1": 809.1, "m": [37.8, 790.8, 48.3, 804.1]}], "answer": [3]}, {"no": 14, "regions": [{"page": 2, "x0": 365.0, "y0": 51.0, "x1": 728.0, "y1": 182.8}], "text": "14. 주파수 분할 다중화(FDM) 방식에 대한 설명으로 옳지 않은 것은?\n①송신 신호들을 각각 서로 다른 주파수를 가지는 반송파들로\n변조한다.\n②채널 간 보호 대역을 두기 때문에 주파수 대역 사용 효율이\n낮아진다.\n③채널 간 보호 대역은 인접 채널 간의 신호 간섭을 완전히 제거한다.\n④다중화 및 역다중화 시에 신호를 분리하기 위해 필터가 필요하다.", "choices": [{"r": 0, "x0": 365.0, "y0": 68.0, "x1": 728.0, "y1": 105.4, "m": [391.8, 71.0, 402.2, 84.2]}, {"r": 0, "x0": 365.0, "y0": 105.4, "x1": 728.0, "y1": 142.8, "m": [391.8, 108.4, 402.2, 121.6]}, {"r": 0, "x0": 365.0, "y0": 142.8, "x1": 728.0, "y1": 161.5, "m": [391.8, 145.8, 402.2, 159.1]}, {"r": 0, "x0": 365.0, "y0": 161.5, "x1": 728.0, "y1": 182.8, "m": [391.8, 164.5, 402.2, 177.8]}], "answer": [3]}, {"no": 15, "regions": [{"page": 2, "x0": 365.0, "y0": 372.0, "x1": 728.0, "y1": 757.3}], "text": "15. 직교 함수 축 와 상에 그레이 부호를 적용한 16－QAM의\n성상도가 다음과 같을 때, 심볼 S1, S2, S3, S4에 할당된 비트열로\n바르게 연결한 것은?\nS1\nS2\nS3\nS4\n①1111\n0101\n1101\n0111\n②0101\n1111\n1101\n0111\n③1101\n0111\n0101\n1111\n④0111\n1111\n0101\n1101", "choices": [{"r": 0, "x0": 365.0, "y0": 679.9, "x1": 728.0, "y1": 698.6, "m": [391.8, 682.9, 402.2, 696.1]}, {"r": 0, "x0": 365.0, "y0": 698.6, "x1": 728.0, "y1": 717.3, "m": [391.8, 701.6, 402.2, 714.8]}, {"r": 0, "x0": 365.0, "y0": 717.3, "x1": 728.0, "y1": 736.0, "m": [391.8, 720.3, 402.2, 733.5]}, {"r": 0, "x0": 365.0, "y0": 736.0, "x1": 728.0, "y1": 757.3, "m": [391.8, 739.0, 402.2, 752.3]}], "answer": [4]}, {"no": 16, "regions": [{"page": 3, "x0": 0.0, "y0": 51.0, "x1": 362.0, "y1": 201.1}], "text": "16. 채널 부호화에 대한 설명으로 옳지 않은 것은?\n①허프만(Huffman) 부호화는 채널 부호화의 일종이다.\n②(7, 4) 선형 블록 부호에서 메시지와 패리티 비트 수는 각각 4개와\n3개다.\n③선형 블록 부호의 오류정정 능력은 부호어 사이의 최소 해밍\n거리와 관련이 있다.\n④ARQ 방식은 수신단에서 송신단으로 재전송 요청을 하기 위한\n역방향 링크가 필요하다.", "choices": [{"r": 0, "x0": 0.0, "y0": 68.0, "x1": 362.0, "y1": 86.7, "m": [37.8, 71.0, 48.3, 84.2]}, {"r": 0, "x0": 0.0, "y0": 86.7, "x1": 362.0, "y1": 124.1, "m": [37.8, 89.7, 48.3, 102.9]}, {"r": 0, "x0": 0.0, "y0": 124.1, "x1": 362.0, "y1": 161.5, "m": [37.8, 127.1, 48.3, 140.3]}, {"r": 0, "x0": 0.0, "y0": 161.5, "x1": 362.0, "y1": 201.1, "m": [37.8, 164.5, 48.3, 177.8]}], "answer": [1]}, {"no": 17, "regions": [{"page": 3, "x0": 0.0, "y0": 369.3, "x1": 362.0, "y1": 482.5}], "text": "17. 비동기(non-coherent) BFSK에서 비트 지속 시간이 1 [s]일 때,\n두 반송파가 직교하기 위해 필요한 최소 주파수 간격MHz은?\n①0.5\n②1\n③2\n④4", "choices": [{"r": 0, "x0": 0.0, "y0": 405.2, "x1": 362.0, "y1": 423.9, "m": [37.8, 408.2, 48.3, 421.4]}, {"r": 0, "x0": 0.0, "y0": 423.9, "x1": 362.0, "y1": 442.6, "m": [37.8, 426.9, 48.3, 440.1]}, {"r": 0, "x0": 0.0, "y0": 442.6, "x1": 362.0, "y1": 461.3, "m": [37.8, 445.6, 48.3, 458.8]}, {"r": 0, "x0": 0.0, "y0": 461.3, "x1": 362.0, "y1": 482.5, "m": [37.8, 464.3, 48.3, 477.5]}], "answer": [2]}, {"no": 18, "regions": [{"page": 3, "x0": 0.0, "y0": 650.1, "x1": 362.0, "y1": 815.1}], "text": "18. 디지털 변조 성상도에서 BPSK의 최소 유클리드 거리(신호점 간의\n최소 거리)는 QPSK의 최소 유클리드 거리의 몇 배인가? (단,\n두 변조 방식 간 심볼 에너지는 동일하다)\n\n①\n\n②\n\n③\n④", "choices": [{"r": 0, "x0": 0.0, "y0": 711.9, "x1": 362.0, "y1": 745.6, "m": [37.8, 714.9, 48.3, 728.2]}, {"r": 0, "x0": 0.0, "y0": 745.6, "x1": 362.0, "y1": 774.9, "m": [37.8, 748.6, 48.3, 761.8]}, {"r": 0, "x0": 0.0, "y0": 774.9, "x1": 362.0, "y1": 793.8, "m": [37.8, 777.9, 48.3, 791.1]}, {"r": 0, "x0": 0.0, "y0": 793.8, "x1": 362.0, "y1": 815.1, "m": [37.8, 796.8, 48.3, 810.1]}], "answer": [3]}, {"no": 19, "regions": [{"page": 3, "x0": 365.0, "y0": 51.1, "x1": 728.0, "y1": 331.8}], "text": "19. 다음과 같은 이진 대칭 채널을 통해 이진 정보 비트를 동일하게\n세 번 반복하여 전송하고, 수신된 세 개의 비트들에 대해 다수결 원칙\n기반 복호를 한다고 할 때, 평균 정보 비트 오류 확률은? (단, 정보\n비트 0과 1의 발생 확률은 같고, 교차 확률 는 이다)\n①\n②\n③\n④", "choices": [{"r": 0, "x0": 365.0, "y0": 248.1, "x1": 728.0, "y1": 269.0, "m": [391.8, 251.1, 402.2, 264.3]}, {"r": 0, "x0": 365.0, "y0": 269.0, "x1": 728.0, "y1": 289.7, "m": [391.8, 272.0, 402.2, 285.2]}, {"r": 0, "x0": 365.0, "y0": 289.7, "x1": 728.0, "y1": 310.6, "m": [391.8, 292.7, 402.2, 305.9]}, {"r": 0, "x0": 365.0, "y0": 310.6, "x1": 728.0, "y1": 331.8, "m": [391.8, 313.6, 402.2, 326.8]}], "answer": [2]}, {"no": 20, "regions": [{"page": 3, "x0": 365.0, "y0": 536.9, "x1": 728.0, "y1": 787.5}], "text": "20. 발생 확률이 동일한 두 이진 데이터를 AWGN 채널을 통해 송신하고,\n수신단에서 정합 필터를 통해 검출된 신호가 ±이라면,\n평균 비트 오류 확률을 －함수로 나타낸 것은? (단, 는 양의\n상수이고, 은 평균이 이고 분산이 인 가우시안 랜덤 변수이며,\n\n\n∞\n\n－함수는 \n\n이다)\nexp\n\n\n\n\n\n\n①\n\n②\n\n\n③\n\n\n\n④\n", "choices": [{"r": 0, "x0": 365.0, "y0": 657.1, "x1": 728.0, "y1": 690.6, "m": [391.8, 660.1, 402.2, 673.4]}, {"r": 0, "x0": 365.0, "y0": 690.6, "x1": 728.0, "y1": 724.0, "m": [391.8, 693.6, 402.2, 706.8]}, {"r": 0, "x0": 365.0, "y0": 724.0, "x1": 728.0, "y1": 759.2, "m": [391.8, 727.0, 402.2, 740.3]}, {"r": 0, "x0": 365.0, "y0": 759.2, "x1": 728.0, "y1": 787.5, "m": [391.8, 762.2, 402.2, 775.4]}], "answer": [1]}, {"no": 21, "regions": [{"page": 4, "x0": 0.0, "y0": 51.3, "x1": 362.0, "y1": 164.5}], "text": "21. 크기가 200 [byte]인 프레임을 100 [s]마다 6개씩 전송할 때,\n전송 속도Mbps는?\n①12\n②24\n③48\n④96", "choices": [{"r": 0, "x0": 0.0, "y0": 87.2, "x1": 362.0, "y1": 105.9, "m": [37.8, 90.2, 48.3, 103.4]}, {"r": 0, "x0": 0.0, "y0": 105.9, "x1": 362.0, "y1": 124.6, "m": [37.8, 108.9, 48.3, 122.1]}, {"r": 0, "x0": 0.0, "y0": 124.6, "x1": 362.0, "y1": 143.3, "m": [37.8, 127.6, 48.3, 140.8]}, {"r": 0, "x0": 0.0, "y0": 143.3, "x1": 362.0, "y1": 164.5, "m": [37.8, 146.3, 48.3, 159.5]}], "answer": [4]}, {"no": 22, "regions": [{"page": 4, "x0": 0.0, "y0": 350.8, "x1": 362.0, "y1": 501.2}], "text": "22. 선형 귀환 천이 레지스터를 이용하여 발생한 최장 부호열 PN 부호에\n대한 설명으로 옳지 않은 것은?\n①주기성을 갖는다.\n②CDMA 시스템에서 기지국 및 섹터를 구분하는 데 사용된다.\n③모든 천이 레지스터의 값이 0인 경우에도 PN 부호열을 생성할 수\n있다.\n④부호의 길이가 길수록 한 칩 지연된 부호열과의 자기상관 값은\n에 가깝게 된다.", "choices": [{"r": 0, "x0": 0.0, "y0": 386.5, "x1": 362.0, "y1": 405.2, "m": [37.8, 389.5, 48.3, 402.7]}, {"r": 0, "x0": 0.0, "y0": 405.2, "x1": 362.0, "y1": 423.9, "m": [37.8, 408.2, 48.3, 421.4]}, {"r": 0, "x0": 0.0, "y0": 423.9, "x1": 362.0, "y1": 461.3, "m": [37.8, 426.9, 48.3, 440.1]}, {"r": 0, "x0": 0.0, "y0": 461.3, "x1": 362.0, "y1": 501.2, "m": [37.8, 464.3, 48.3, 477.5]}], "answer": [3]}, {"no": 23, "regions": [{"page": 4, "x0": 0.0, "y0": 686.1, "x1": 362.0, "y1": 819.8}], "text": "23. 100개의 부반송파를 사용하는 OFDM 시스템이 8－QAM 변조 방식을\n사용하고 있다. 보호 구간이 심볼 길이의 20 %이고 데이터율이\n30 [Mbps]일 때, 시스템 대역폭MHz은?\n①10\n②12.5\n③15\n④17.5", "choices": [{"r": 0, "x0": 0.0, "y0": 742.5, "x1": 362.0, "y1": 761.2, "m": [37.8, 745.5, 48.3, 758.7]}, {"r": 0, "x0": 0.0, "y0": 761.2, "x1": 362.0, "y1": 779.9, "m": [37.8, 764.2, 48.3, 777.4]}, {"r": 0, "x0": 0.0, "y0": 779.9, "x1": 362.0, "y1": 798.6, "m": [37.8, 782.9, 48.3, 796.1]}, {"r": 0, "x0": 0.0, "y0": 798.6, "x1": 362.0, "y1": 819.8, "m": [37.8, 801.6, 48.3, 814.8]}], "answer": [2]}, {"no": 24, "regions": [{"page": 4, "x0": 365.0, "y0": 51.0, "x1": 728.0, "y1": 219.8}], "text": "24. 통신 채널을 선형 시불변 시스템으로 모델링하는 경우, 무왜곡 전송에\n대한 설명으로 옳지 않은 것은?\n①무왜곡 전송이 가능한 통신 채널의 주파수 진폭 응답은 상수이다.\n②무왜곡 전송이 가능한 통신 채널의 주파수 위상 응답은 주파수에\n대해 선형적이다.\n③수신 신호가 일정 시간만큼 지연되면 파형이 송신 신호와 동일한\n모양을 가지더라도 무왜곡 전송으로 볼 수 없다.\n④채널의 왜곡 효과를 보상하기 위해 사용되는 등화기의 주파수\n응답은 채널의 주파수 응답의 역수이다.", "choices": [{"r": 0, "x0": 365.0, "y0": 86.7, "x1": 728.0, "y1": 105.4, "m": [391.8, 89.7, 402.2, 102.9]}, {"r": 0, "x0": 365.0, "y0": 105.4, "x1": 728.0, "y1": 142.8, "m": [391.8, 108.4, 402.2, 121.6]}, {"r": 0, "x0": 365.0, "y0": 142.8, "x1": 728.0, "y1": 180.2, "m": [391.8, 145.8, 402.2, 159.1]}, {"r": 0, "x0": 365.0, "y0": 180.2, "x1": 728.0, "y1": 219.8, "m": [391.8, 183.2, 402.2, 196.5]}], "answer": [3]}, {"no": 25, "regions": [{"page": 4, "x0": 365.0, "y0": 518.7, "x1": 728.0, "y1": 669.1}], "text": "25. 총 주파수 대역폭이 35 [MHz]인 FDMA 방식의 셀룰러시스템에서\n한 사용자당 50 [kHz]의 전이중(full-duplex)대역폭을 사용하고 있다.\n클러스터의 크기가 7일 때, 셀당 동시에 수용 가능한 최대 사용자\n수는? (단, 사용자 대역 간 보호 대역은 없다고 가정한다)\n①100\n②150\n③200\n④250", "choices": [{"r": 0, "x0": 365.0, "y0": 591.8, "x1": 728.0, "y1": 610.5, "m": [391.8, 594.8, 402.2, 608.0]}, {"r": 0, "x0": 365.0, "y0": 610.5, "x1": 728.0, "y1": 629.2, "m": [391.8, 613.5, 402.2, 626.7]}, {"r": 0, "x0": 365.0, "y0": 629.2, "x1": 728.0, "y1": 647.9, "m": [391.8, 632.2, 402.2, 645.4]}, {"r": 0, "x0": 365.0, "y0": 647.9, "x1": 728.0, "y1": 669.1, "m": [391.8, 650.9, 402.2, 664.1]}], "answer": [1]}]}