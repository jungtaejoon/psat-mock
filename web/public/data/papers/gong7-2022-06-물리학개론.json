0.6, 409.0]}, {"r": 0, "x0": 298.5, "y0": 409.9, "x1": 595.0, "y1": 425.7, "m": [331.7, 412.9, 340.6, 424.7]}, {"r": 0, "x0": 298.5, "y0": 425.7, "x1": 595.0, "y1": 441.2, "m": [331.7, 428.7, 340.6, 440.4]}, {"r": 0, "x0": 298.5, "y0": 441.2, "x1": 595.0, "y1": 461.0, "m": [331.7, 444.2, 340.6, 456.0]}], "answer": [1]}, {"no": 15, "regions": [{"page": 2, "x0": 298.5, "y0": 544.0, "x1": 595.0, "y1": 816.0}], "text": "문 15. 그림은 가느다란 줄을 따라 진행하는 파동의 한 순간의 모습을\n나타낸 것이다. 파동은 50 m/s의 속력으로  방향으로 진행한다.\n이 파동의 진동수[Hz]는?\n①12.5\n②40\n③62.5\n④125", "choices": [{"r": 0, "x0": 298.5, "y0": 749.2, "x1": 595.0, "y1": 764.9, "m": [331.7, 752.2, 340.6, 764.0]}, {"r": 0, "x0": 298.5, "y0": 764.9, "x1": 595.0, "y1": 780.5, "m": [331.7, 767.9, 340.6, 779.7]}, {"r": 0, "x0": 298.5, "y0": 780.5, "x1": 595.0, "y1": 796.2, "m": [331.7, 783.5, 340.6, 795.3]}, {"r": 0, "x0": 298.5, "y0": 796.2, "x1": 595.0, "y1": 816.0, "m": [331.7, 799.2, 340.6, 811.0]}], "answer": [4]}, {"no": 16, "regions": [{"page": 3, "x0": 0.0, "y0": 44.7, "x1": 295.5, "y1": 354.3}], "text": "문 16. 동일한 금속판 2개로 만든 평행판 축전기에서 극판의 전하량이\n일 때, 전위차계의 바늘이 그림과 같았다. 전하량이 로\n유지될 때, 전위차계의 바늘을 오른쪽으로 움직이게 하는 조작만을\n모두 고르면?\nㄱ. 두 극판의 면적을 넓힌다.\nㄴ. 두 극판 사이의 간격을 넓힌다.\nㄷ. 유전상수가 공기의 유전상수보다 큰 유전체를 두 극판\n사이에 삽입한다.\n①ㄱ\n②ㄴ\n③ㄱ, ㄷ\n④ㄴ, ㄷ", "choices": [{"r": 0, "x0": 0.0, "y0": 287.6, "x1": 295.5, "y1": 303.1, "m": [42.5, 290.6, 51.3, 302.4]}, {"r": 0, "x0": 0.0, "y0": 303.1, "x1": 295.5, "y1": 318.8, "m": [42.5, 306.1, 51.3, 317.9]}, {"r": 0, "x0": 0.0, "y0": 318.8, "x1": 295.5, "y1": 334.6, "m": [42.5, 321.8, 51.3, 333.6]}, {"r": 0, "x0": 0.0, "y0": 334.6, "x1": 295.5, "y1": 354.3, "m": [42.5, 337.6, 51.3, 349.3]}], "answer": [2]}, {"no": 17, "regions": [{"page": 3, "x0": 0.0, "y0": 414.4, "x1": 295.5, "y1": 789.5}], "text": "문 17. 그림은 질량이 이고 전하량이 인 정지한 입자가 전극판\n사이에서 전위차 로 최대한 가속된 후, 자기장 에 수직으로\n입사하여 반지름이 인 원을 그리며 형광판에 도달하는 것을\n나타낸 것이다. 이에 대한 설명으로 옳은 것만을 모두 고르면?\n(단, 는 지면에 수직으로 들어간다)\nㄱ. 를 2배로 하면, 는 2배가 된다.\n배가 된다.\nㄴ. 의 크기가 2배가 되면, 는 \nㄷ. 의 방향을 반대로 바꾸면, 입자의 경로는 오른쪽으로\n휘어진다.\n①ㄴ\n②ㄱ, ㄷ\n③ㄴ, ㄷ\n④ㄱ, ㄴ, ㄷ", "choices": [{"r": 0, "x0": 0.0, "y0": 722.7, "x1": 295.5, "y1": 738.3, "m": [42.5, 725.7, 51.3, 737.5]}, {"r": 0, "x0": 0.0, "y0": 738.3, "x1": 295.5, "y1": 754.0, "m": [42.5, 741.3, 51.3, 753.1]}, {"r": 0, "x0": 0.0, "y0": 754.0, "x1": 295.5, "y1": 769.7, "m": [42.5, 757.0, 51.3, 768.8]}, {"r": 0, "x0": 0.0, "y0": 769.7, "x1": 295.5, "y1": 789.5, "m": [42.5, 772.7, 51.3, 784.5]}], "answer": [3]}, {"no": 18, "regions": [{"page": 3, "x0": 298.5, "y0": 44.7, "x1": 595.0, "y1": 236.4}], "text": "문 18. 그림과 같이 저항값이 300 Ω인 저항과 인덕턴스가 2 H인 코일이\n각진동수가 200 rad/s이고 전압의 최댓값이 100 V인 교류 전원에\n연결되어 있다. 저항에서 소비되는 전력[W]의 최댓값은?\n①3\n②6\n③12\n④24", "choices": [{"r": 0, "x0": 298.5, "y0": 169.6, "x1": 595.0, "y1": 185.3, "m": [331.7, 172.6, 340.6, 184.4]}, {"r": 0, "x0": 298.5, "y0": 185.3, "x1": 595.0, "y1": 201.0, "m": [331.7, 188.3, 340.6, 200.1]}, {"r": 0, "x0": 298.5, "y0": 201.0, "x1": 595.0, "y1": 216.6, "m": [331.7, 204.0, 340.6, 215.8]}, {"r": 0, "x0": 298.5, "y0": 216.6, "x1": 595.0, "y1": 236.4, "m": [331.7, 219.6, 340.6, 231.4]}], "answer": [3]}, {"no": 19, "regions": [{"page": 3, "x0": 298.5, "y0": 296.8, "x1": 595.0, "y1": 538.0}], "text": "문 19. 그림과 같은 회로에서 점 A와 점 B 사이의 전위차[V]는? (단,\n전지의 내부 저항은 무시한다)\n①5\n②6\n③10\n④12", "choices": [{"r": 0, "x0": 298.5, "y0": 471.2, "x1": 595.0, "y1": 486.8, "m": [331.7, 474.2, 340.6, 486.0]}, {"r": 0, "x0": 298.5, "y0": 486.8, "x1": 595.0, "y1": 502.5, "m": [331.7, 489.8, 340.6, 501.6]}, {"r": 0, "x0": 298.5, "y0": 502.5, "x1": 595.0, "y1": 518.2, "m": [331.7, 505.5, 340.6, 517.3]}, {"r": 0, "x0": 298.5, "y0": 518.2, "x1": 595.0, "y1": 538.0, "m": [331.7, 521.2, 340.6, 533.0]}], "answer": [3]}, {"no": 20, "regions": [{"page": 3, "x0": 298.5, "y0": 589.4, "x1": 595.0, "y1": 791.0}], "text": "문 20. 수소 원자의 상태를 기술하는 파동함수는 전자의 양자 상태를\n나타내기 위해 주양자수 , 궤도양자수 , 궤도 자기양자수 을\n필요로 한다. 이에 대한 설명으로 옳은 것만을 모두 고르면?\nㄱ. 주양자수의 허용된 값은 ⋯이다.\nㄴ. 주양자수 일 때, 궤도양자수