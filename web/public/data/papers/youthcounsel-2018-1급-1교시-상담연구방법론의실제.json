.8, 719.6]}, {"r": 0, "x0": 0.0, "y0": 725.0, "x1": 595.0, "y1": 762.7, "m": [50.7, 728.0, 61.8, 741.2]}], "orig": 62, "answer": [2]}, {"no": 13, "regions": [{"page": 14, "x0": 0.0, "y0": 40.0, "x1": 595.0, "y1": 185.9}], "text": "63. 연구논문작성에관한설명으로옳지않은것은?\n①이론적배경에서는선행연구고찰을통해연구문제의근거를논리적으로밝힌다.\n②선행연구고찰을통해연구가설이도출되기도한다.\n③「미국심리학회(APA) 출판규정」6판에따르면30개단어이하의직접인용은큰따옴표(“ ”)\n없이독립된단락으로처리한다.\n④간접인용은직접인용과달리큰따옴표없이기술하고출처를밝힌다.\n⑤연구문제가측정가능한변인중심으로진술되었다면용어의정의를기술해야한다.", "choices": [{"r": 0, "x0": 0.0, "y0": 62.2, "x1": 595.0, "y1": 83.9, "m": [50.7, 65.2, 61.8, 78.4]}, {"r": 0, "x0": 0.0, "y0": 83.9, "x1": 595.0, "y1": 105.5, "m": [50.7, 86.9, 61.8, 100.1]}, {"r": 0, "x0": 0.0, "y0": 105.5, "x1": 595.0, "y1": 143.1, "m": [50.7, 108.5, 61.8, 121.7]}, {"r": 0, "x0": 0.0, "y0": 143.1, "x1": 595.0, "y1": 164.7, "m": [50.7, 146.1, 61.8, 159.4]}, {"r": 0, "x0": 0.0, "y0": 164.7, "x1": 595.0, "y1": 185.9, "m": [50.7, 167.7, 61.8, 180.9]}], "orig": 63, "answer": [3]}, {"no": 14, "regions": [{"page": 14, "x0": 0.0, "y0": 201.7, "x1": 595.0, "y1": 345.8}], "text": "64. 연구문제에관한설명으로옳은것을모두고른것은?\nㄱ. 선행연구의양이방대한주제의연구문제는가치가떨어지므로지양해야한다.\nㄴ. 수행가능성을고려하여연구문제를선정한다.\nㄷ. 탐색적연구는반드시연구문제와연구가설이모두진술되어야하나, 실험연구는\n가설대신연구문제만진술해도무방하다.\nㄹ. 검증가능한연구문제는명료하게진술된변인들간의관계를포함한다.\n①ㄱ\n②ㄱ, ㄴ\n③ㄴ, ㄹ\n④ㄷ, ㄹ\n⑤ㄴ, ㄷ, ㄹ", "choices": [{"r": 0, "x0": 0.0, "y0": 324.2, "x1": 148.2, "y1": 345.8, "m": [50.7, 327.2, 61.8, 340.5]}, {"r": 0, "x0": 148.2, "y0": 324.2, "x1": 249.5, "y1": 345.8, "m": [152.2, 327.2, 163.2, 340.5]}, {"r": 0, "x0": 249.5, "y0": 324.2, "x1": 351.0, "y1": 345.8, "m": [253.5, 327.2, 264.6, 340.5]}, {"r": 0, "x0": 351.0, "y0": 324.2, "x1": 452.4, "y1": 345.8, "m": [355.0, 327.2, 366.0, 340.5]}, {"r": 0, "x0": 452.4, "y0": 324.2, "x1": 595.0, "y1": 345.8, "m": [456.4, 327.2, 467.4, 340.5]}], "orig": 64, "answer": [3]}, {"no": 15, "regions": [{"page": 14, "x0": 0.0, "y0": 361.3, "x1": 595.0, "y1": 507.2}], "text": "65. 가설에관한설명으로옳지않은것은?\n①관찰결과의귀납은일반적인이론정립의기초가된다.\n②통계적가설은가상적분포에근거하여검토된다.\n③이론적토대없이설정된가설은합리적근거를진술할필요가있다.\n④통계적