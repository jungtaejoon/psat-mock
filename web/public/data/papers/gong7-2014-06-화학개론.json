.6, 738.3]}, {"r": 0, "x0": 298.5, "y0": 738.4, "x1": 595.0, "y1": 764.2, "m": [331.7, 741.4, 340.6, 751.3]}, {"r": 0, "x0": 298.5, "y0": 764.2, "x1": 595.0, "y1": 790.1, "m": [331.7, 767.2, 340.6, 777.0]}, {"r": 0, "x0": 298.5, "y0": 790.1, "x1": 595.0, "y1": 821.3, "m": [331.7, 793.1, 340.6, 802.9]}], "answer": [1]}, {"no": 12, "regions": [{"page": 1, "x0": 0.0, "y0": 40.3, "x1": 295.5, "y1": 182.8}], "text": "문12. 페놀과알코올의특성에대한설명으로옳은것만을모두고르면?\nㄱ. 페놀과알코올은모두－OH 작용기를가지고있다.\nㄴ. 알코올의끓는점은분자량이비슷한에터(ether)나\n탄화수소보다훨씬더높다.\nㄷ. 알코올은소듐(Na)과반응하여수소기체를발생시킨다.\nㄹ. 페놀은산화를촉진시킨다.\n①ㄱ, ㄴ\n②ㄴ, ㄷ\n③ㄱ, ㄴ, ㄷ\n④ㄱ, ㄴ, ㄷ, ㄹ", "choices": [{"r": 0, "x0": 0.0, "y0": 148.0, "x1": 163.7, "y1": 164.6, "m": [42.5, 151.0, 51.3, 160.8]}, {"r": 0, "x0": 163.7, "y0": 148.0, "x1": 295.5, "y1": 164.6, "m": [167.7, 151.0, 176.5, 160.8]}, {"r": 0, "x0": 0.0, "y0": 164.6, "x1": 163.7, "y1": 182.8, "m": [42.5, 167.6, 51.3, 177.5]}, {"r": 0, "x0": 163.7, "y0": 164.6, "x1": 295.5, "y1": 182.8, "m": [167.7, 167.6, 176.5, 177.5]}], "answer": [3]}, {"no": 13, "regions": [{"page": 1, "x0": 0.0, "y0": 198.2, "x1": 295.5, "y1": 376.2}], "text": "문13. 시트릭산(H3C6H5O7)은수용액에서3개의수소이온을만들어낼수\n있다. 같은온도에서세이온화반응의평형상수는K1, K2, K3 이다.\n+(aq) ＋H2C6H5O7\n-(aq)\nH3C6H5O7(aq) ⇌H\nK1\n-(aq) ⇌H\n+(aq) ＋HC6H5O7\n2-(aq)\nH2C6H5O7\nK2\n2-(aq) ⇌H\n+(aq) ＋C6H5O7\n3-(aq)\nHC6H5O7\nK3\n+(aq) ＋C6H5O7\n3-(aq) 반응의\n동일한온도에서H3C6H5O7(aq) ⇌3H\n평형상수(K)를K1, K2, K3로나타내면?\n①․․\n②\n③\n․\n④\n\n․․\n", "choices": [{"r": 0, "x0": 0.0, "y0": 324.8, "x1": 163.7, "y1": 350.9, "m": [42.5, 327.8, 51.3, 337.6]}, {"r": 0, "x0": 163.7, "y0": 324.8, "x1": 295.5, "y1": 350.9, "m": [167.7, 327.8, 176.5, 337.6]}, {"r": 0, "x0": 0.0, "y0": 350.9, "x1": 163.7, "y1": 376.2, "m": [42.5, 353.9, 51.3, 363.7]}, {"r": 0, "x0": 163.7, "y0": 350.9, "x1": 295.5, "y1": 376.2, "m": [167.7, 353.9, 176.5, 363.7]}], "answer": [1]}, {"no": 14, "regions": [{"page": 1, "x0": 0.0, "y0": 392.7, "x1": 295.5, "y1": 536.4}], "text": "문14. 시스－트랜스(cis-trans) 이성질체를가지는