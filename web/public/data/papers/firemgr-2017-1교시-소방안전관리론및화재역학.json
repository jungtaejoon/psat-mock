3, 256.9]}, {"r": 0, "x0": 0.0, "y0": 263.1, "x1": 595.0, "y1": 285.5, "m": [51.3, 266.1, 63.3, 280.5]}], "orig": 18, "answer": [2]}, {"no": 19, "regions": [{"page": 3, "x0": 0.0, "y0": 305.4, "x1": 595.0, "y1": 470.8}], "text": "19. 공간화재특성에관한설명으로옳지않은것은?\n①플래시오버는실내의국소화재로부터실내모든가연물표면이연소하는현상을말한다.\n②백드래프트는신선한공기가유입되어실내에축적되었던가연성가스가단시간에\n폭발적으로연소하는현상이다.\n③환기지배형화재란환기가충분한상태에서가연물의양에따라제어되는화재를말\n한다.\n④공간화재에서연기와공기의유동은주로온도상승에의한부력의영향때문이다.", "choices": [{"r": 0, "x0": 0.0, "y0": 329.6, "x1": 595.0, "y1": 353.3, "m": [51.3, 332.6, 63.3, 347.0]}, {"r": 0, "x0": 0.0, "y0": 353.3, "x1": 595.0, "y1": 400.8, "m": [51.3, 356.3, 63.3, 370.6]}, {"r": 0, "x0": 0.0, "y0": 400.8, "x1": 595.0, "y1": 448.4, "m": [51.3, 403.8, 63.3, 418.2]}, {"r": 0, "x0": 0.0, "y0": 448.4, "x1": 595.0, "y1": 470.8, "m": [51.3, 451.4, 63.3, 465.8]}], "orig": 19, "answer": [3]}, {"no": 20, "regions": [{"page": 3, "x0": 0.0, "y0": 490.6, "x1": 595.0, "y1": 627.4}], "text": "20. 연기제연방식에관한설명으로옳은것은?\n①밀폐제연방식은비교적대규모공간의연기제어에적합하다.\n②자연제연방식은실내ㆍ외의온도, 개구부의높이나형상, 외부바람등에영향을받는다.\n③스모크타워제연방식은기계배연의한방법으로저층건물에적합하다.\n④기계제연방식은넓은면적의구획과좁은면적의구획을공동배연할경우넓은면적\n에서현저한압력저하가일어난다.", "choices": [{"r": 0, "x0": 0.0, "y0": 515.0, "x1": 595.0, "y1": 538.6, "m": [51.3, 518.0, 63.3, 532.3]}, {"r": 0, "x0": 0.0, "y0": 538.6, "x1": 595.0, "y1": 562.2, "m": [51.3, 541.6, 63.3, 556.0]}, {"r": 0, "x0": 0.0, "y0": 562.2, "x1": 595.0, "y1": 585.8, "m": [51.3, 565.2, 63.3, 579.6]}, {"r": 0, "x0": 0.0, "y0": 585.8, "x1": 595.0, "y1": 627.4, "m": [51.3, 588.8, 63.3, 603.2]}], "orig": 20, "answer": [2]}, {"no": 21, "regions": [{"page": 3, "x0": 0.0, "y0": 647.2, "x1": 595.0, "y1": 768.7}], "text": "21. 연소물질과연소시생성되는연소가스의연결이옳은것을모두고른것은? (단,\n불완전연소를포함한다.)\nㄱ. PVC - 황화수소\nㄴ. 나일론- 암모니아\nㄷ. 폴리스티렌- 시안화수소\nㄹ. 레이온- 아크롤레인\n①ㄱ, ㄴ\n②ㄱ, ㄷ\n③ㄴ, ㄹ\n④ㄷ, ㄹ", "choices": [{"r": 0, "x0": 0.0, "y0": 745.9, "x1": 174.1, "y1": 768.7, "m": [51.3, 748.9, 63.3, 763.3]}, {"r": 0, "x0": 174.1, "y0": 745.9, "x1": 300.8, "y1": 768.7, "m": [178.1, 748.9, 190.1, 763.3]}, {"r": 0, "x0": 300.8, 