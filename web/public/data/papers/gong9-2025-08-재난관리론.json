2.2, 408.3]}, {"r": 0, "x0": 365.0, "y0": 413.6, "x1": 728.0, "y1": 434.8, "m": [391.8, 416.6, 402.2, 429.8]}], "answer": [3]}, {"no": 11, "regions": [{"page": 0, "x0": 365.0, "y0": 458.2, "x1": 728.0, "y1": 691.6}], "text": "11.\n자연재해대책법\n상 가뭄의 예방 및 대비에 대한 설명으로 옳지\n않은 것은?\n①재난관리책임기관의 장은 가뭄 방재를 위하여 필요한 조사 및\n연구를 하여야 한다.\n②관계 중앙행정기관의 장은 시장ㆍ군수ㆍ구청장이 수립한\n중장기대책에 필요한 사업비의 일부를 지원할 수 있다.\n③시장ㆍ군수ㆍ구청장은 가뭄 방재를 위하여 관계 중앙행정기관의\n장과 합동으로 가뭄 예보 및 경보 체계를 운영하여야 한다.\n④시장ㆍ군수ㆍ구청장은 상습가뭄재해지역에 대하여 빗물모으기시설\n설치 등 가뭄 피해를 줄이기 위한 중장기대책을 수립ㆍ시행하여야\n한다.", "choices": [{"r": 0, "x0": 365.0, "y0": 499.2, "x1": 728.0, "y1": 542.1, "m": [391.8, 502.2, 402.2, 515.4]}, {"r": 0, "x0": 365.0, "y0": 542.1, "x1": 728.0, "y1": 584.9, "m": [391.8, 545.1, 402.2, 558.4]}, {"r": 0, "x0": 365.0, "y0": 584.9, "x1": 728.0, "y1": 627.7, "m": [391.8, 587.9, 402.2, 601.2]}, {"r": 0, "x0": 365.0, "y0": 627.7, "x1": 728.0, "y1": 691.6, "m": [391.8, 630.7, 402.2, 644.0]}], "answer": [3]}, {"no": 12, "regions": [{"page": 0, "x0": 365.0, "y0": 715.3, "x1": 728.0, "y1": 1012.5}], "text": "12.\n재해경감을 위한 기업의 자율활동 지원에 관한 법률\n상 기업의\n재해경감에 대한 설명으로 (가), (나)에 들어갈 내용을 바르게 연결한\n것은?\n○행정안전부장관은 기업의 재해경감활동계획 수립을 위한\n을 작성ㆍ고시하여야 한다.\n(가)\n○우수기업으로 인증을 받고자 하는 기업은\n(가)\n의 범위에서\n(나)\n으로 정하는 기준에 따라 재해경감활동계획을\n수립ㆍ시행하여야 한다.\n(가)\n(나)\n①재난관리표준\n대통령령\n②재난관리표준\n총리령\n③사업연속성확보계획\n대통령령\n④사업연속성확보계획\n총리령", "choices": [{"r": 0, "x0": 365.0, "y0": 927.0, "x1": 728.0, "y1": 948.5, "m": [391.8, 930.0, 402.2, 943.3]}, {"r": 0, "x0": 365.0, "y0": 948.5, "x1": 728.0, "y1": 970.0, "m": [391.8, 951.5, 402.2, 964.7]}, {"r": 0, "x0": 365.0, "y0": 970.0, "x1": 728.0, "y1": 991.3, "m": [391.8, 973.0, 402.2, 986.2]}, {"r": 0, "x0": 365.0, "y0": 991.3, "x1": 728.0, "y1": 1012.5, "m": [391.8, 994.3, 402.2, 1007.5]}], "answer": [1]}, {"no": 13, "regions": [{"page": 1, "x0": 0.0, "y0": 51.1, "x1": 362.0, "y1": 216.0}], "text": "상 지역별 방재성능목표 설정ㆍ운용에 대한\n13.\n자연재해대책법\n설명으로 (가)에 들어갈 숫자는?\n특별시장ㆍ광역시장ㆍ시장 및 군수(광역시에 속한 군의 군수를\n포함)는 지역별 방재성능목표를 공표한 날부터\n(가)\n년마다\n그 타당성 여부를 검토하여 필요한 경우에는 설정된 방재성능\n목표를 변경ㆍ공표하여야 한다.\n①2\n②3\n③5\n④10", "choices": [{"r": 0, "x0": 0.0, "y0": 176.0, "x1": 193.6, "y1": 194.7, "m": [37.8, 179.0, 48.3, 192.3]}, {"r": 0, "x0": 193.6, "y0": 176.0, "x1": 362.0, "y1": 194.7, "m": [197.6, 179.0, 208.1, 192.3]}, {"r": 0, "x0": 0.0, "y0": 194.7, "x1": 193.6, "y1": 216.0, "m": [37.8, 197.7, 48.3, 211.0]}, {"r": 0, "x0": 193.6, "y0": 194.7, "x1": 362.0, "y1": 216.0, "m": [197.6, 197.7, 208.1, 211.0]}], "answer": [3]}, {"no": 14, "regions": [{"page": 1, "x0": 0.0, "y0": 234.0, "x1": 362.0, "y1": 414.3}], "text": "14.\n재해경감을 위한 기업의 자율활동 지원에 관한 법률\n상 행정안전부\n장관이 우수기업 인증을 취소하여야 하는 사유에 해당하는 것만을\n모두 고르면?\nㄱ. 인증 평가기준에 미달되는 경우\nㄴ. 거짓이나 그 밖의 부정한 방법으로 인증을 받은 경우\nㄷ. 양도ㆍ양수ㆍ합병 등에 의하여 인증받은 요건이 변경된\n경우\n①ㄱ\n②ㄴ\n③ㄱ, ㄷ\n④ㄴ, ㄷ", "choices": [{"r": 0, "x0": 0.0, "y0": 374.4, "x1": 193.6, "y1": 393.1, "m": [37.8, 377.4, 48.3, 390.6]}, {"r": 0, "x0": 193.6, "y0": 374.4, "x1": 362.0, "y1": 393.1, "m": [197.6, 377.4, 208.1, 390.6]}, {"r": 0, "x0": 0.0, "y0": 393.1, "x1": 193.6, "y1": 414.3, "m": [37.8, 396.1, 48.3, 409.3]}, {"r": 0, "x0": 193.6, "y0": 393.1, "x1": 362.0, "y1": 414.3, "m": [197.6, 396.1, 208.1, 409.3]}], "answer": [2]}, {"no": 15, "regions": [{"page": 1, "x0": 0.0, "y0": 432.3, "x1": 362.0, "y1": 732.0}], "text": "상 자연재해 예방을 위한 점검 대상 시설ㆍ\n15.\n자연재해대책법 시행령\n지역 및 점검 방법 등에 대한 설명으로 옳지 않은 것은?\n①재난관리책임기관의 장은 설해(雪害)에 의한 재해 발생 우려 시설 및\n지역에 대한 정기점검을 매년 11월에서 다음 해 2월 중 1회 이상\n하여야 한다.\n②재난관리책임기관의 장은 설해에 의한 재해 발생 우려 시설 및\n지역에 대하여 정기점검을 한 후에는 반드시 안전진단을 하여야\n한다.\n③재난관리책임기관의 장은 풍수해에 의한 재해 발생 우려 시설\n및 지역에 대한 정기점검을 매년 3월에서 5월 중 1회 이상 하여야\n한다.\n④재난관리책임기관의 장은 자연재해 예방을 위하여 점검 대상\n시설 및 지역에 대한 점검 또는 안전진단을 하였을 때에는 그\n결과에 따른 안전대책을 마련하고, 점검 또는 안전진단의 결과와\n조치 사항 등을 행정안전부장관이 정하는 바에 따라 기록ㆍ관리\n하여야 한다.", "choices": [{"r": 0, "x0": 0.0, "y0": 467.9, "x1": 362.0, "y1": 524.0, "m": [37.8, 470.9, 48.3, 484.1]}, {"r": 0, "x0": 0.0, "y0": 524.0, "x1": 362.0, "y1": 580.1, "m": [37.8, 527.0, 48.3, 540.3]}, {"r": 0, "x0": 0.0, "y0": 580.1, "x1": 362.0, "y1": 636.3, "m": [37.8, 583.1, 48.3, 596.4]}, {"r": 0, "x0": 0.0, "y0": 636.3, "x1": 362.0, "y1": 732.0, "m": [37.8, 639.3, 48.3, 652.5]}], "answer": [2]}, {"no": 16, "regions": [{"page": 1, "x0": 0.0, "y0": 750.4, "x1": 362.0, "y1": 1011.8}], "text": "상 용어 정의로 (가), (나)에 들어갈 내용을 바르게\n16.\n자연재해대책법\n연결한 것은?\n○‘재해영향성검토’란 자연재해에 영향을 미치는\n(가)\n으로\n인한 재해 유발 요인을 예측ㆍ분석하고 이에 대한 대책을\n마련하는 것을 말한다.\n○‘지구단위 홍수방어기준’이란 상습침수지역이나 재해위험도가\n높은\n지역에\n대하여\n침수\n피해를\n방지하기\n위하여\n(나)\n이 정한 기준을 말한다.\n(가)\n(나)\n①행정계획\n행정안전부장관\n②행정계획\n지방자치단체의 장\n③방재관리대책\n행정안전부장관\n④방재관리대책\n지방자치단체의 장", "choices": [{"r": 0, "x0": 0.0, "y0": 934.5, "x1": 362.0, "y1": 953.2, "m": [37.8, 937.5, 48.3, 950.7]}, {"r": 0, "x0": 0.0, "y0": 953.2, "x1": 362.0, "y1": 971.9, "m": [37.8, 956.2, 48.3, 969.4]}, {"r": 0, "x0": 0.0, "y0": 971.9, "x1": 362.0, "y1": 990.6, "m": [37.8, 974.9, 48.3, 988.1]}, {"r": 0, "x0": 0.0, "y0": 990.6, "x1": 362.0, "y1": 1011.8, "m": [37.8, 993.6, 48.3, 1006.8]}], "answer": [1]}, {"no": 17, "regions": [{"page": 1, "x0": 365.0, "y0": 51.1, "x1": 728.0, "y1": 307.6}], "text": "17.\n재난 및 안전관리 기본법 시행령\n상 재난대비훈련에 대한 설명으로\n옳지 않은 것은?\n①훈련주관기관의 장은 관계 기관과 합동으로 참여하는 재난대비\n훈련을 각각 소관 분야별로 주관하여 연 1회 이상 실시하여야\n한다.\n②재난대비훈련에 참여하는 데에 필요한 비용은 훈련주관기관이\n부담한다.\n③훈련주관기관의 장은 재난대비훈련을 실시하는 경우, 훈련일 15일\n전까지 훈련일시, 훈련장소, 훈련내용, 훈련방법, 훈련참여 인력\n및 장비, 그 밖에 훈련에 필요한 사항을 훈련참여기관의 장에게\n통보하여야 한다.\n④훈련참여기관의 장은 재난대비훈련 실시 후 10일 이내에 그\n결과를 훈련주관기관의 장에게 제출하여야 한다.", "choices": [{"r": 0, "x0": 365.0, "y0": 88.9, "x1": 728.0, "y1": 148.2, "m": [391.8, 91.9, 402.2, 105.1]}, {"r": 0, "x0": 365.0, "y0": 148.2, "x1": 728.0, "y1": 187.8, "m": [391.8, 151.2, 402.2, 164.4]}, {"r": 0, "x0": 365.0, "y0": 187.8, "x1": 728.0, "y1": 266.9, "m": [391.8, 190.8, 402.2, 204.0]}, {"r": 0, "x0": 365.0, "y0": 266.9, "x1": 728.0, "y1": 307.6, "m": [391.8, 269.9, 402.2, 283.2]}], "answer": [2]}, {"no": 18, "regions": [{"page": 1, "x0": 365.0, "y0": 328.1, "x1": 728.0, "y1": 556.6}], "text": "18. 재난 및 안전관리 기본법령상 재난 발생 시 다음과 같은 기능을\n수행하는 기구의 장은?\n○긴급구조대응계획의 집행\n○긴급구조활동의 지휘ㆍ통제\n○국가 긴급구조대책의 총괄ㆍ조정\n○긴급구조지원기관간의 역할분담 등 긴급구조를 위한\n현장활동계획의 수립\n①국무총리\n②행정안전부장관\n③소방청장\n④지방자치단체의 장", "choices": [{"r": 0, "x0": 365.0, "y0": 476.0, "x1": 728.0, "y1": 495.8, "m": [391.8, 479.0, 402.2, 492.3]}, {"r": 0, "x0": 365.0, "y0": 495.8, "x1": 728.0, "y1": 515.6, "m": [391.8, 498.8, 402.2, 512.1]}, {"r": 0, "x0": 365.0, "y0": 515.6, "x1": 728.0, "y1": 535.4, "m": [391.8, 518.6, 402.2, 531.9]}, {"r": 0, "x0": 365.0, "y0": 535.4, "x1": 728.0, "y1": 556.6, "m": [391.8, 538.4, 402.2, 551.6]}], "answer": [3]}, {"no": 19, "regions": [{"page": 1, "x0": 365.0, "y0": 576.7, "x1": 728.0, "y1": 754.2}], "text": "19. 재해구호법령상 구호에 대한 설명으로 옳지 않은 것은?\n①장사(葬事)의 지원은 구호의 종류에 포함한다.\n②\n새마을운동조직 육성법\n에 따른 새마을운동조직은 구호지원\n기관에 포함한다.\n③구호기관이 필요하다고 인정하더라도 이재민에게 현금을 지급하여\n구호할 수 없다.\n④구호기간은 이재민의 피해정도 및 생활정도 등을 고려하여 6개월\n이내로 하지만, 구호기관이 이재민의 주거 안정을 위하여 필요하다고\n인정하는 경우에는 구호기간을 연장할 수 있다.", "choices": [{"r": 0, "x0": 365.0, "y0": 594.8, "x1": 728.0, "y1": 614.5, "m": [391.8, 597.8, 402.2, 611.0]}, {"r": 0, "x0": 365.0, "y0": 614.5, "x1": 728.0, "y1": 654.1, "m": [391.8, 617.5, 402.2, 630.8]}, {"r": 0, "x0": 365.0, "y0": 654.1, "x1": 728.0, "y1": 693.7, "m": [391.8, 657.1, 402.2, 670.4]}, {"r": 0, "x0": 365.0, "y0": 693.7, "x1": 728.0, "y1": 754.2, "m": [391.8, 696.7, 402.2, 709.9]}], "answer": [3]}, {"no": 20, "regions": [{"page": 1, "x0": 365.0, "y0": 774.7, "x1": 728.0, "y1": 1009.6}], "text": "20.\n자연재해대책법 시행령\n상 행정안전부장관의 재해영향평가등 협의\n결과 통보 기간으로 (가), (나)에 들어갈 숫자를 바르게 연결한 것은?\n○재해영향평가: 다음의 구분에 따른 기간\n－개발사업의 부지면적이 5만제곱미터 이상이거나 개발사업의\n길이가 10킬로미터 이상인 개발사업:\n(가)\n일\n－그 외의 개발사업:\n(나)\n일\n(가)\n(나)\n①45\n20\n②60\n20\n③45\n30\n④60\n30", "choices": [{"r": 0, "x0": 365.0, "y0": 929.0, "x1": 728.0, "y1": 948.7, "m": [391.8, 932.0, 402.2, 945.2]}, {"r": 0, "x0": 365.0, "y0": 948.7, "x1": 728.0, "y1": 968.5, "m": [391.8, 951.7, 402.2, 965.0]}, {"r": 0, "x0": 365.0, "y0": 968.5, "x1": 728.0, "y1": 988.3, "m": [391.8, 971.5, 402.2, 984.8]}, {"r": 0, "x0": 365.0, "y0": 988.3, "x1": 728.0, "y1": 1009.6, "m": [391.8, 991.3, 402.2, 1004.6]}], "answer": [3]}]}