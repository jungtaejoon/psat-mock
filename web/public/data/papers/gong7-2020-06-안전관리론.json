, 417.7]}, {"r": 0, "x0": 0.0, "y0": 419.8, "x1": 295.5, "y1": 439.6, "m": [42.5, 422.8, 51.3, 434.6]}], "answer": [4]}, {"no": 4, "regions": [{"page": 0, "x0": 0.0, "y0": 453.5, "x1": 295.5, "y1": 557.8}], "text": "문\n4.\n위험물안전관리법시행령\n상제4류위험물의품명별물질을\n바르게연결한것은?\n①제1석유류－중유, 클레오소트유\n②제2석유류－등유, 경유\n③제3석유류－기어유, 실린더유\n④제4석유류－아세톤, 휘발유", "choices": [{"r": 0, "x0": 0.0, "y0": 487.1, "x1": 295.5, "y1": 503.9, "m": [42.5, 490.1, 51.3, 501.9]}, {"r": 0, "x0": 0.0, "y0": 503.9, "x1": 295.5, "y1": 520.8, "m": [42.5, 506.9, 51.3, 518.7]}, {"r": 0, "x0": 0.0, "y0": 520.8, "x1": 295.5, "y1": 537.6, "m": [42.5, 523.8, 51.3, 535.6]}, {"r": 0, "x0": 0.0, "y0": 537.6, "x1": 295.5, "y1": 557.8, "m": [42.5, 540.6, 51.3, 552.4]}], "answer": [2]}, {"no": 5, "regions": [{"page": 0, "x0": 0.0, "y0": 571.3, "x1": 295.5, "y1": 692.2}], "text": "문\n5.\n소방기본법\n상생활안전활동에해당하지않는것은? (단, 화재,\n재난․재해, 그밖의위급한상황에해당하는것은제외한다)\n①붕괴, 낙하등이우려되는고드름, 나무, 위험구조물등의\n제거활동\n②위해동물, 벌등의포획및퇴치활동\n③단전사고시비상전원또는조명의공급\n④집회․공연등각종행사시사고에대비한근접대기", "choices": [{"r": 0, "x0": 0.0, "y0": 605.0, "x1": 295.5, "y1": 638.7, "m": [42.5, 608.0, 51.3, 619.8]}, {"r": 0, "x0": 0.0, "y0": 638.7, "x1": 295.5, "y1": 655.4, "m": [42.5, 641.7, 51.3, 653.5]}, {"r": 0, "x0": 0.0, "y0": 655.4, "x1": 295.5, "y1": 672.3, "m": [42.5, 658.4, 51.3, 670.2]}, {"r": 0, "x0": 0.0, "y0": 672.3, "x1": 295.5, "y1": 692.2, "m": [42.5, 675.3, 51.3, 687.1]}], "answer": [4]}, {"no": 6, "regions": [{"page": 0, "x0": 0.0, "y0": 706.0, "x1": 295.5, "y1": 825.4}], "text": "문\n6. 블레이크(Blake, R.)와모튼(Mouton, J.)의관리그리드모형에서\n혼자다계획하고통제하고명령하며부하를생산도구로여기고\n업적달성에만관심이있는지도자유형은?\n①과업형\n②친목형\n③무관심형\n④단합형", "choices": [{"r": 0, "x0": 0.0, "y0": 756.5, "x1": 295.5, "y1": 773.4, "m": [42.5, 759.5, 51.3, 771.3]}, {"r": 0, "x0": 0.0, "y0": 773.4, "x1": 295.5, "y1": 790.2, "m": [42.5, 776.4, 51.3, 788.2]}, {"r": 0, "x0": 0.0, "y0": 790.2, "x1": 295.5, "y1": 807.1, "m": [42.5, 793.2, 51.3, 805.0]}, {"r": 0, "x0": 0.0, "y0": 807.1, "x1": 295.5, "y1": 825.4, "m": [42.5, 810.1, 51.3, 821.9]}]