1": 220.5, "m": [36.6, 202.2, 47.6, 215.5]}, {"r": 0, "x0": 162.1, "y0": 199.2, "x1": 295.5, "y1": 220.5, "m": [166.1, 202.2, 177.1, 215.5]}], "orig": 24, "answer": [4]}, {"no": 25, "regions": [{"page": 3, "x0": 0.0, "y0": 256.4, "x1": 295.5, "y1": 442.9}], "text": "25. 다음의업적과관련된왕으로옳은것은?\nㆍ속대전을편찬하였다.\nㆍ지나친형벌이나악형을금지하였다.\nㆍ백성의부담을줄여주기위해균역법\n을시행하였다.\n①성종\n②숙종\n③영조\n④정조\n제2과목: 관광자원해설", "choices": [{"r": 0, "x0": 0.0, "y0": 361.3, "x1": 97.3, "y1": 442.9, "m": [36.6, 364.3, 47.6, 377.5]}, {"r": 0, "x0": 97.3, "y0": 361.3, "x1": 162.1, "y1": 442.9, "m": [101.3, 364.3, 112.4, 377.5]}, {"r": 0, "x0": 162.1, "y0": 361.3, "x1": 226.9, "y1": 442.9, "m": [166.1, 364.3, 177.1, 377.5]}, {"r": 0, "x0": 226.9, "y0": 361.3, "x1": 295.5, "y1": 442.9, "m": [230.9, 364.3, 241.9, 377.5]}], "orig": 25, "answer": [3]}]}