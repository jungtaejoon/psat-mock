.3, 817.4]}, {"r": 0, "x0": 0.0, "y0": 824.6, "x1": 362.0, "y1": 848.0, "m": [37.8, 827.6, 48.3, 840.9]}, {"r": 0, "x0": 0.0, "y0": 848.0, "x1": 362.0, "y1": 871.5, "m": [37.8, 851.0, 48.3, 864.3]}, {"r": 0, "x0": 0.0, "y0": 871.5, "x1": 362.0, "y1": 894.8, "m": [37.8, 874.5, 48.3, 887.8]}], "answer": [3]}, {"no": 4, "regions": [{"page": 0, "x0": 369.0, "y0": 49.5, "x1": 728.0, "y1": 228.3}], "text": "4. 자료 (,)(＝,,…,)에 단순선형회귀모형 ＝＋＋를\n최소제곱법으로 적합한 회귀계수의 추정값은 ＝, ＝이다.\n\n\n\n＝일 때 \n의 값은? (단, 는 (, )을 따르고 서로\n\n\n독립이다)\n①\n②\n③\n④", "choices": [{"r": 0, "x0": 369.0, "y0": 150.2, "x1": 728.0, "y1": 169.2, "m": [391.8, 153.2, 402.2, 166.5]}, {"r": 0, "x0": 369.0, "y0": 169.2, "x1": 728.0, "y1": 188.1, "m": [391.8, 172.2, 402.2, 185.4]}, {"r": 0, "x0": 369.0, "y0": 188.1, "x1": 728.0, "y1": 207.1, "m": [391.8, 191.1, 402.2, 204.4]}, {"r": 0, "x0": 369.0, "y0": 207.1, "x1": 728.0, "y1": 228.3, "m": [391.8, 210.1, 402.2, 223.3]}], "answer": [3]}, {"no": 5, "regions": [{"page": 0, "x0": 369.0, "y0": 399.1, "x1": 728.0, "y1": 880.0}], "text": "5. 세 가지 백신에 따른 항체 생성률의 차이가 있는지를 확인하기 위해\n백신 (＝,,)를 접종한 후, 항체가 미생성된 개체 수()와\n항체가 생성된 개체 수()를 조사한 결과는 다음과 같다.\n항체 생성 여부\n미생성\n생성\n계\n백신\n\n\n\n백신 \n\n\n\n백신 \n\n\n\n백신 \n\n\n계\n\n백신 를 접종한 후 항체가 생성된 개체의 비율을 라 할 때,\n가설 : ‘＝＝이다’ 대 : ‘, ,  중 적어도 하나는\n다르다’에 대해 카이제곱검정을 하고자 한다. 귀무가설이 참일 때\n백신 를 접종한 후 항체가 미생성된 개체의 추정 기대도수를\n이라 하고 항체가 생성된 개체의 추정 기대도수를 이라 하자.\n이에 대한 설명으로 옳은 것만을 모두 고르면?\nㄱ. 이다.\n이다.\nㄴ. \n\nㄷ. 카이제곱 검정통계량의 자유도는 이다.\n①ㄱ\n②ㄱ, ㄷ\n③ㄴ, ㄷ\n④ㄱ, ㄴ, ㄷ", "choices": [{"r": 0, "x0": 369.0, "y0": 802.7, "x1": 728.0, "y1": 821.4, "m": [391.8, 805.7, 402.2, 818.9]}, {"r": 0, "x0": 369.0, "y0": 821.4, "x1": 728.0, "y1": 840.1, "m": [391.8, 824.4, 402.2, 837.6]}, {"r": 0, "x0": 369.0, "y0": 840.1, "x1": 728.0, "y1": 858.8, "m": [391.8, 843.1, 402.2, 856.3]}, {"r": 0, "x0": 369.0, "y0": 858.8, "x1": 728.0, "y1": 880.0, "m": [391.8, 861.8, 402.2, 875.0]}], "answer": [4]}, {"no": 6, "regions": [{"page": 1, "x0": 0.0, "y0": 49.5, "x1": 362.0, "y1": 195.8}], "text": "6. 다음 자료의 중앙값과 산술평균이 각각 , 일 때, －의 값은?\n(단, ≥이다)\n, , , , , , , \n①\n②\n③\n④", "choices": [{"r": 0, "x0": 0.0, "y0": 117.6, "x1": 362.0, "y1": 136.7, "m": [37.8, 120.6, 48.3, 133.9]}, {"r": 0, "x0": 0.0, "y0": 136.7, "x1": 362.0, "y1": 155.6, "m": [37.8, 139.7, 48.3, 152.9]}, {"r": 0, "x0": 0.0, "y0": 155.6, "x1": 362.0, "y1": 174.6, "m": [37.8, 158.6, 48.3, 171.9]}, {"r": 0, "x0": 0.0, "y0": 174.6, "x1": 362.0, "y1": 195.8, "m": [37.8, 177.6, 48.3, 190.8]}], "answer": [4]}, {"no": 7, "regions": [{"page": 1, "x0": 0.0, "y0": 335.1, "x1": 362.0, "y1": 563.8}], "text": "7. 어느 대학교는 메일을 스팸 메일과 정상 메일로 분류하는 프로그램을\n사용하고 있다. 이 프로그램은 스팸 메일의 %를 스팸 메일로\n분류하고, 정상 메일의 %는 스팸 메일로 분류한다. 이 대학교\n전체 메일의 %는 스팸 메일이다. 이 프로그램이 어떤 메일을\n스팸 메일로 분류했을 때, 해당 메일이 정상 메일일 확률은?\n\n①\n\n②\n\n③\n\n④", "choices": [{"r": 0, "x0": 0.0, "y0": 434.9, "x1": 362.0, "y1": 468.4, "m": [37.8, 437.9, 48.3, 451.2]}, {"r": 0, "x0": 0.0, "y0": 468.4, "x1": 362.0, "y1": 501.9, "m": [37.8, 471.4, 48.3, 484.6]}, {"r": 0, "x0": 0.0, "y0": 501.9, "x1": 362.0, "y1": 535.4, "m": [37.8, 504.9, 48.3, 518.2]}, {"r": 0, "x0": 0.0, "y0": 535.4, "x1": 362.0, "y1": 563.8, "m": [37.8, 538.4, 48.3, 551.6]}], "answer": [1]}, {"no": 8, "regions": [{"page": 1, "x0": 0.0, "y0": 761.9, "x1": 362.0, "y1": 951.8}], "text": "8. 볼펜을 제조하는 어느 회사에서는 자사 제품의 판매 비율 를\n추정하고자 한다. 판매되는 볼펜을 대상으로 임의추출한 개 표본 중\n자사 제품의 비율을 이용하여 를 추정할 때, % 신뢰수준에서\n에 대한 추정량의 오차한계를  이하로 하는 최소 표본의 크기는?\n(단, 확률변수 가 표준정규분포를 따를 때 ≥＝,\n≥＝이다)\n①\n②\n③\n④", "choices": [{"r": 0, "x0": 0.0, "y0": 873.7, "x1": 362.0, "y1": 892.6, "m": [37.8, 876.7, 48.3, 889.9]}, {"r": 0, "x0": 0.0, "y0": 892.6, "x1": 362.0, "y1": 911.6, "m": [37.8, 895.6, 48.3, 908.9]}, {"r": 0, "x0": 0.0, "y0": 911.6, "x1": 362.0, "y1": 930.5, "m": [37.8, 914.6, 48.3, 927.8]}, {"r": 0, "x0": 0.0, "y0": 930.5, "x1": 362.0, "y1": 951.8, "m": [37.8, 933.5, 48.3, 946.8]}], "answer": [2]}, {"no": 9, "regions": [{"page": 1, "x0": 365.0, "y0": 51.4, "x1": 728.0, "y1": 295.8}], "text": "9. 모평균이 인 정규분포를 따르는 모집단에서 임의추출한 개 자료의\n표본평균이 이다. 가설 : ＝ 대 : ≠에 대한\n검정통계량의 －값이 일 때, 이에 대한 설명으로 옳은 것만을\n모두 고르면?\nㄱ. 가설 : ＝ 대 : ≠에 대하여 유의수준 %\n에서 귀무가설을 기각한다.\nㄴ. 가설 : ＝ 대 : 에 대한 －값은 이다.\nㄷ. 모평균 에 대한 % 신뢰구간은 을 포함한다.\n①ㄴ\n②ㄱ, ㄷ\n③ㄴ, ㄷ\n④ㄱ, ㄴ, ㄷ", "choices": [{"r": 0, "x0": 365.0, "y0": 218.5, "x1": 728.0, "y1": 237.2, "m": [391.8, 221.5, 402.2, 234.7]}, {"r": 0, "x0": 365.0, "y0": 237.2, "x1": 728.0, "y1": 255.9, "m": [391.8, 240.2, 402.2, 253.4]}, {"r": 0, "x0": 365.0, "y0": 255.9, "x1": 728.0, "y1": 274.6, "m": [391.8, 258.9, 402.2, 272.1]}, {"r": 0, "x0": 365.0, "y0": 274.6, "x1": 728.0, "y1": 295.8, "m": [391.8, 277.6, 402.2, 290.8]}], "answer": [3]}, {"no": 10, "regions": [{"page": 1, "x0": 365.0, "y0": 332.1, "x1": 728.0, "y1": 563.4}], "text": "10. 자료 (,)(＝,,…,)에서 표본평균 는 각각 , 이다.\n이 자료에 단순선형회귀모형 ＝＋를 최소제곱법으로 적합하여\n얻은 의 추정량을 이라 할 때, 이에 대한 설명으로 옳은 것만을\n모두 고르면? (단, 는 (, )을 따르고 서로 독립이다)\nㄱ. 잔차제곱합의 자유도는 이다.\nㄴ. 추정 회귀직선은 (,)을 지난다.\nㄷ. 은 의 비편향추정량(unbiased estimator)이다.\n①ㄷ\n②ㄱ, ㄴ\n③ㄱ, ㄷ\n④ㄱ, ㄴ, ㄷ", "choices": [{"r": 0, "x0": 365.0, "y0": 486.0, "x1": 728.0, "y1": 504.7, "m": [391.8, 489.0, 402.2, 502.2]}, {"r": 0, "x0": 365.0, "y0": 504.7, "x1": 728.0, "y1": 523.4, "m": [391.8, 507.7, 402.2, 520.9]}, {"r": 0, "x0": 365.0, "y0": 523.4, "x1": 728.0, "y1": 542.1, "m": [391.8, 526.4, 402.2, 539.7]}, {"r": 0, "x0": 365.0, "y0": 542.1, "x1": 728.0, "y1": 563.4, "m": [391.8, 545.1, 402.2, 558.4]}], "answer": [3]}, {"no": 11, "regions": [{"page": 1, "x0": 365.0, "y0": 600.1, "x1": 728.0, "y1": 959.2}], "text": "11. 어느 놀이공원은 검은 공과 흰 공이 들어 있는 상자에서 흰 공을\n로\n뽑으면 선물을 증정하고 있다. 상자 속의 흰 공의 비율 는 \n로 낮아졌다는 주장을 확인하기 위하여\n알려져 있다. 이 비율이 \n다음 가설에 대한 검정을 실시하고자 한다.\n