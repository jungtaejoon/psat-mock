.6, 314.2, 707.9]}, {"r": 0, "x0": 0.0, "y0": 712.9, "x1": 595.0, "y1": 735.6, "m": [49.9, 715.9, 61.9, 730.2]}], "orig": 16, "answer": [2]}, {"no": 17, "regions": [{"page": 5, "x0": 0.0, "y0": 41.2, "x1": 595.0, "y1": 234.3}], "text": "17. 유형자산의회계처리에관한설명으로옳지않은것은?\n①유형자산의잔존가치와내용연수는적어도매회계연도말에재검토한다.\n②유형자산의제거로인하여발생하는손익은순매각금액과장부금액의차이로결정한다.\n③유형자산을다른비화폐성자산과교환하여취득하는경우, 교환거래에상업적실질이\n결여되었다면취득한유형자산의원가를제공한자산의장부금액으로측정한다.\n④생산용식물은유형자산으로회계처리하지만, 생산용식물에서자라는생산물은생물자산\n으로회계처리한다.\n⑤손상된유형자산에대해제3자로부터보상금을받는경우, 이보상금은수취한시점에\n당기손익으로반영한다.", "choices": [{"r": 0, "x0": 0.0, "y0": 65.3, "x1": 595.0, "y1": 87.6, "m": [49.9, 68.3, 61.9, 82.7]}, {"r": 0, "x0": 0.0, "y0": 87.6, "x1": 595.0, "y1": 109.9, "m": [49.9, 90.6, 61.9, 105.0]}, {"r": 0, "x0": 0.0, "y0": 109.9, "x1": 595.0, "y1": 151.3, "m": [49.9, 112.9, 61.9, 127.3]}, {"r": 0, "x0": 0.0, "y0": 151.3, "x1": 595.0, "y1": 192.7, "m": [49.9, 154.3, 61.9, 168.7]}, {"r": 0, "x0": 0.0, "y0": 192.7, "x1": 595.0, "y1": 234.3, "m": [49.9, 195.7, 61.9, 210.1]}], "orig": 17, "answer": [5]}, {"no": 18, "regions": [{"page": 5, "x0": 0.0, "y0": 257.0, "x1": 595.0, "y1": 441.2}], "text": "18. (주)한국은20×1년초영업에사용할목적의차량운반구와임대수익목적의건물\n을각각취득하였다. 차량운반구에대해서는재평가모형을, 건물에대해서는공정\n가치모형을적용하고있다. 차량운반구의취득원가는￦200,000, 건물의취득원가\n는￦100,000이다. 감가상각을적용할경우두자산모두내용연수5년, 잔존가치\n￦0, 정액법을사용한다. 20×1년말차량운반구의공정가치는￦170,000, 건물의\n공정가치는￦120,000이다. 차량운반구및건물과관련된회계처리가(주)한국의\n20×1년도당기순이익에미치는영향은?\n①￦40,000 증가\n②￦50,000 증가\n③￦20,000 감소\n④￦40,000 감소\n⑤￦60,000 감소", "choices": [{"r": 0, "x0": 0.0, "y0": 396.2, "x1": 214.2, "y1": 418.5, "m": [49.9, 399.2, 61.9, 413.5]}, {"r": 0, "x0": 214.2, "y0": 396.2, "x1": 382.4, "y1": 418.5, "m": [218.2, 399.2, 230.2, 413.5]}, {"r": 0, "x0": 382.4, "y0": 396.2, "x1": 595.0, "y1": 418.5, "m": [386.4, 399.2, 398.4, 413.5]}, {"r": 0, "x0": 0.0, "y0": 418.5, "x1": 214.2, "y1": 441.2, "m": [49.9, 421.5, 61.9, 435.8]}, {"r": 0, "x0": 214.2, "y0": 418.5, "x1": 595.0, "y1": 441.2, "m": [218.2, 421.5, 230.2, 435.8]}], "orig": 18, "answer": [3]}, {"no": 19, "regions": 